{
  "name": "calligraphy-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "ARPHICPL.TXT",
    "assets/data/",
    "assets/presets/",
    "src/"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./geometry": "./src/geometry.mjs",
    "./scenes/yong": "./src/scenes/yong.mjs",
    "./scenes/poem": "./src/scenes/poem.mjs",
    "./text": "./src/text/index.mjs"
  },
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "serve:api": ".venv/bin/uvicorn backend.app:app --reload --port 8000",
    "render": "npm run render:video:yong",
    "render:poem": "npm run render:video:poem",
    "render:video:yong": ".venv/bin/calligraphy --text '永' --output outputs/yong-animation.mp4",
    "render:video:poem": ".venv/bin/calligraphy --text '明月松间照，清泉石上流' --per-line 5 --output outputs/poem-animation.mp4",
    "render:still": ".venv/bin/calligraphy --text '永' --output outputs/yong.png",
    "fetch:characters": ".venv/bin/python -m calligraphy.text.glyphs",
    "test": "node --test tests/*.test.mjs",
    "render:text": ".venv/bin/calligraphy",
    "prepare:font": ".venv/bin/calligraphy --prepare-only"
  },
  "dependencies": {
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
